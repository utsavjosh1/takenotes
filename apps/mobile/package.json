{
  "name": "@takenotes/mobile",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "help": "echo 'takenotes mobile: npm run start (phone via Expo Go, same WiFi) | start:web (browser) | start:tunnel (needs expo login)'", "start": "NODE_PATH=./node_modules expo start --lan", "start:web": "NODE_PATH=./node_modules expo start --lan --web", "start:tunnel": "NODE_PATH=./node_modules expo start --tunnel",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json",
    "test": "vitest run --root ../.. tests/mobile/m0-seam.test.ts tests/mobile/m1-browse.test.ts tests/mobile/m2-edit.test.ts tests/mobile/m3-polish.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@takenotes/contracts": "0.0.8",
    "@takenotes/core": "0.0.8",
    "@takenotes/platform": "0.0.8",
    "@takenotes/ui": "0.0.8",
    "expo": "^58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4"
  },
  "exports": {
    "./adapters/*": "./src/adapters/*.ts",
    "./browse/*": "./src/browse/*.ts",
    "./capture/*": "./src/capture/*.ts",
    "./editor/*": "./src/editor/*.ts",
    "./index/*": "./src/index/*.ts",
    "./settings/*": "./src/settings/*.ts",
    "./share/*": "./src/share/*.ts",
    "./workspace/*": "./src/workspace/*.ts",
    "./sync/*": "./src/sync/*.ts"
  }
}
