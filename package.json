{
  "name": "takenotes",
  "version": "0.0.1",
  "private": true,
  "description": "takenotes — filesystem-first local Markdown notebook for Windows with WSL awareness.",
  "author": {
    "name": "Utsav Josh",
    "email": "utsav304joshi@gmail.com"
  },
  "desktopName": "takenotes",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron && npm run build:helper",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-main.mjs",
    "build:helper": "node scripts/build-helper.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "package:win": "electron-builder --win nsis zip --publish never",
    "release:verify": "node scripts/verify-release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "fixture:generate": "node scripts/generate-fixture.mjs",
    "audit:deps": "npm audit --omit=dev && npm audit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@lezer/highlight": "1.2.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.3.0": true
  }
}
