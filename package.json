{
  "name": "takenotes",
  "version": "0.0.9",
  "private": true,
  "description": "takenotes — filesystem-first local Markdown notebook for Windows with WSL awareness.",
  "author": {
    "name": "Utsav Joshi",
    "email": "utsav304joshi@gmail.com"
  },
  "desktopName": "takenotes",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "dev": "node tools/scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron && npm run build:server && npm run build:helper",
    "build:renderer": "vite build --config vite.config.ts",
    "build:electron": "node tools/scripts/build-main.mjs",
    "build:helper": "node tools/scripts/build-helper.mjs",
    "build:server": "node tools/scripts/build-server.mjs",
    "server:start": "node dist-server/server.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ui:tokens": "node tools/scripts/generate-ui-tokens.mjs",
    "ui:tokens:check": "node tools/scripts/generate-ui-tokens.mjs --check",
    "lint": "eslint .",
    "test": "vitest run",
    "version:set": "node tools/scripts/set-version.mjs",
    "version:check": "node tools/scripts/check-version.mjs",
    "package:win": "npm run build && electron-builder --win nsis zip --publish never",
    "release:verify": "node tools/scripts/verify-release.mjs",
    "verify:packaged": "node tools/scripts/verify-packaged.mjs",
    "release:notes": "node tools/scripts/release-notes.mjs",
    "fixture:generate": "node tools/scripts/generate-fixture.mjs",
    "audit:deps": "npm audit --omit=dev && npm audit",
    "dev:desktop": "node tools/scripts/dev.mjs",
    "dev:web": "npm --workspace @takenotes/web run dev",
    "mobile:help": "npm --workspace @takenotes/mobile run help"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.2",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.4.3": true
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ]
}
